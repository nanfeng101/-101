<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".myself.MyHomeActivity"
    android:orientation="vertical"
    android:background="#E8E8E8"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <ImageView
                android:scaleType="centerCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/myhome_backgrond"/>

        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="10dp"
            android:layout_marginLeft="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/myhome_fanhui"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="centerCrop"
                android:src="@drawable/geci_ganhui"/>
            <ImageView
                android:layout_marginLeft="290dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="centerCrop"
                android:src="@drawable/gengduo"/>

        </LinearLayout>
        <LinearLayout
            android:layout_marginLeft="20dp"
            android:layout_marginTop="90dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="50dp">
                <ImageView
                    android:id="@+id/myhome_pic"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/wei_login"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_marginLeft="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/myhome_username"
                    android:layout_marginTop="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="南枫"
                    android:textColor="#FFFFFF"/>
                <LinearLayout
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/myhome_sex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="性别"
                        android:textColor="#B3B3B3"
                        android:textSize="8dp"/>
                    <TextView
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:textColor="#B3B3B3"
                        android:textSize="8dp"/>
                    <TextView
                        android:id="@+id/myhome_age"
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="年龄"
                        android:textColor="#B3B3B3"
                        android:textSize="8dp"/>
                    <TextView
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="|"
                        android:textColor="#B3B3B3"
                        android:textSize="8dp"/>
                    <TextView
                        android:id="@+id/myhome_xingzhuo"
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="星座"
                        android:textColor="#B3B3B3"
                        android:textSize="8dp"/>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="150dp"
            android:layout_marginLeft="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/myhome_qianming"
                android:layout_marginLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="专注音乐，还没有签名"
                android:textColor="#676767"
                android:textSize="10dp"/>
            <ImageView
                android:id="@+id/myhome_edit"
                android:layout_marginLeft="5dp"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:scaleType="centerCrop"
                android:src="@drawable/myhome_edit"
                />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_width="350dp"
        android:layout_height="80dp"
        android:orientation="vertical"
        android:background="@drawable/shape_myself_background">
        <LinearLayout
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:id="@+id/myself_linearlayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp">
                <ImageView
                    android:scaleType="centerCrop"
                    android:id="@+id/myself_collect"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/major_lunbotu3"/>
            </androidx.cardview.widget.CardView>>
            <LinearLayout
                android:layout_marginLeft="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我收藏的歌曲"
                    />
                <TextView
                    android:id="@+id/myself_collect_musicsum"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12首"
                    />
            </LinearLayout>
            <ImageView
                android:layout_marginLeft="100dp"
                android:layout_marginTop="15dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/right_jiantou"
                />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="听歌排行"
                android:textColor="#000000"
                android:textSize="18dp"
                />
            <TextView
                android:layout_marginLeft="220dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:textColor="#7C7C7C"
                android:textSize="15dp"
                />
            <ImageView
                android:layout_marginLeft="10dp"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/right_jiantou"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/myhome_jinpai_layout"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_marginTop="15dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/jinpai"/>
            <androidx.cardview.widget.CardView
                android:layout_marginLeft="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp">
                <ImageView
                    android:id="@+id/myhome_jinpai_music_pic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/jinpai"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/myhome_jinpai_music_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不谓侠"
                android:textSize="18dp"
                android:textColor="#000000"/>
                <TextView
                    android:id="@+id/myhome_jinpai_music_singer"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小阿七"
                    android:textSize="14dp"
                    android:textColor="#858585"/>
            </LinearLayout>
            <ImageView
                android:layout_marginLeft="25dp"
                android:layout_marginTop="15dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="centerCrop"
                android:src="@drawable/gengduo"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/myhome_yinpai_layout"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_marginTop="15dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/yinpai"/>
            <androidx.cardview.widget.CardView
                android:layout_marginLeft="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp">
                <ImageView
                    android:id="@+id/myhome_yinpai_music_pic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/yinpai"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/myhome_yinpai_music_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不谓侠"
                    android:textSize="18dp"
                    android:textColor="#000000"/>
                <TextView
                    android:id="@+id/myhome_yinpai_music_singer"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小阿七"
                    android:textSize="14dp"
                    android:textColor="#858585"/>
            </LinearLayout>
            <ImageView
                android:layout_marginLeft="25dp"
                android:layout_marginTop="15dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="centerCrop"
                android:src="@drawable/gengduo"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/myhome_tongpai_layout"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_marginTop="15dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/tongpai"/>
            <androidx.cardview.widget.CardView
                android:layout_marginLeft="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp">
                <ImageView
                    android:id="@+id/myhome_tongpai_music_pic"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tongpai"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/myhome_tongpai_music_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不谓侠"
                    android:textSize="18dp"
                    android:textColor="#000000"/>
                <TextView
                    android:id="@+id/myhome_tongpai_music_singer"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小阿七"
                    android:textSize="14dp"
                    android:textColor="#858585"/>
            </LinearLayout>
            <ImageView
                android:layout_marginLeft="25dp"
                android:layout_marginTop="15dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="centerCrop"
                android:src="@drawable/gengduo"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>